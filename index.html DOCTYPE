<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetPulse Log - Private Testing</title>
    <!-- Tailwind CSS for modern responsive styling -->
    <script src="https://jsdelivr.net"></script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: sans-serif; }
        .neon-glow { box-shadow: 0 0 15px rgba(20, 184, 166, 0.3); }
    </style>
</head>
<body class="flex flex-col items-center justify-start min-h-screen p-4 py-12">

    <!-- App Wrapper Container -->
    <div class="w-full max-w-xl bg-slate-800 p-6 md:p-8 rounded-2xl shadow-xl border border-slate-700 space-y-6">
        
        <!-- App Icon Header -->
        <div class="flex flex-col items-center border-b border-slate-700/60 pb-6">
            <img src="icon.png" alt="PetPulse Log Icon" class="w-24 h-24 rounded-2xl border border-teal-500/30 shadow-lg neon-glow mb-4 object-cover">
            <h1 class="text-3xl font-extrabold text-center text-teal-400 tracking-tight">🐾 PetPulse Log</h1>
            <p class="text-sm text-slate-300 text-center max-w-md mt-3 leading-relaxed">
                A secure mobile dashboard to track your pet's health history, manage prescriptions, and export instant reports for your clinic.
            </p>
            <span class="mt-4 px-3 py-1 bg-teal-500/10 border border-teal-500/30 text-teal-300 font-bold text-xs rounded-full uppercase tracking-widest">
                TOTAL CONTROL
            </span>
        </div>

        <!-- Concerned Pet Owner Visual Container Placeholder -->
        <div class="w-full h-48 bg-slate-900 border-2 border-dashed border-slate-700 rounded-xl flex flex-col items-center justify-center p-4 text-center group transition hover:border-teal-500/40">
            <div class="bg-slate-800 p-3 rounded-full mb-2">
                <svg class="w-6 h-6 text-slate-400 group-hover:text-teal-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <p class="text-sm font-semibold text-slate-300">📸 Concerned Pet Owner Visual Container</p>
            <p class="text-xs text-slate-500 mt-1">Image uploads into this container smoothly</p>
        </div>

        <!-- Premium Feature Checklist -->
        <div class="bg-slate-900/40 border border-slate-700/50 rounded-xl p-5 space-y-4">
            <h3 class="text-xs font-bold text-teal-400 uppercase tracking-wider">What's Included in Premium:</h3>
            <ul class="space-y-3 text-sm">
                <li class="flex items-start gap-3">
                    <span class="text-teal-400 font-bold mt-0.5">✓</span>
                    <div><strong class="text-white">Unlimited Health Logs</strong> — Track every symptom, diagnosis, and medication with no limits.</div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-teal-400 font-bold mt-0.5">✓</span>
                    <div><strong class="text-white">Medication Reminders</strong> — Set automated phone alerts so you never miss a daily dose.</div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-teal-400 font-bold mt-0.5">✓</span>
                    <div><strong class="text-white">One-Click Vet Reports</strong> — Instantly export your pet's complete history for faster clinic check-ins.</div>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-teal-400 font-bold mt-0.5">✓</span>
                    <div><strong class="text-white">Multiple Pet Profiles</strong> — Keep accurate medical records for every pet in your household.</div>
                </li>
            </ul>
        </div>

        <!-- Testimonial Section -->
        <div class="bg-slate-900/20 border-l-4 border-teal-500/40 p-4 italic text-slate-300 text-sm rounded-r-xl leading-relaxed">
            "During Max's allergy flare-up, I forgot exactly when his last pill was. Having his entire prescription history right on my phone saved our vet visit. This app is an absolute lifesaver." 
            <span class="block mt-2 font-semibold text-xs text-slate-400 not-italic">— Sarah M., Golden Retriever Owner</span>
        </div>

        <!-- Beta Registration Footer Action Form -->
        <div class="pt-4 border-t border-slate-700/60 space-y-4">
            <p class="text-xs text-center text-slate-400 max-w-sm mx-auto leading-relaxed">
                🔒 Join the private beta today. The first 100 pet owners lock in <span class="text-teal-400 font-bold">50% off Premium for life</span> when the mobile app launches.
            </p>

            <form id="betaForm" class="space-y-3">
                <div id="successAlert" class="hidden p-3 bg-teal-500/20 border border-teal-500 text-teal-300 rounded-lg text-xs text-center font-medium">
                    🎉 Spot secured! You are on the 50% lifetime discount list.
                </div>
                <div class="flex flex-col sm:flex-row gap-2">
                    <input type="email" id="betaEmail" required class="flex-1 bg-slate-900 border border-slate-700 rounded-xl p-3 text-white focus:outline-none focus:border-teal-400 text-sm" placeholder="Enter your email address">
                    <button type="submit" class="bg-teal-500 hover:bg-teal-600 text-slate-900 font-extrabold px-6 py-3 rounded-xl transition text-sm cursor-pointer shadow-lg shadow-teal-500/10 whitespace-nowrap">
                        Secure My Spot 🐾
                    </button>
                </div>
            </form>
        </div>

    </div>

    <!-- Interactive Script Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('betaForm');
            const alertBox = document.getElementById('successAlert');
            const emailInput = document.getElementById('betaEmail');

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                const registration = {
                    email: emailInput.value,
                    date: new Date().toISOString()
                };

                localStorage.setItem('petPulseBetaUser', JSON.stringify(registration));
                
                emailInput.classList.add('hidden');
                form.querySelector('button').classList.add('hidden');
                alertBox.classList.remove('hidden');
            });
        });
    </script>
</body>
</html>
