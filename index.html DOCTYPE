<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetPulse Log - Private Testing</title>
    <!-- Tailwind CSS for sleek styling matching your theme -->
    <script src="https://jsdelivr.net"></script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: sans-serif; }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-4">

    <!-- App Wrapper Container -->
    <div class="w-full max-w-md bg-slate-800 p-6 rounded-2xl shadow-xl border border-slate-700">
        <h1 class="text-2xl font-bold text-center text-teal-400 mb-2">🐾 PetPulse Log</h1>
        <p class="text-xs text-center text-slate-400 uppercase tracking-widest font-semibold mb-6">Now In Private Testing</p>

        <!-- Dynamic Success Message Alert -->
        <div id="successAlert" class="hidden mb-4 p-3 bg-teal-500/20 border border-teal-500 text-teal-300 rounded-lg text-sm text-center">
            🎉 Successfully registered for private testing access!
        </div>

        <!-- Testing Access Registration Form -->
        <form id="logSignupForm" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Tester Name</label>
                <input type="text" id="testerName" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-teal-400 text-sm" placeholder="Your Name">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Email Address</label>
                <input type="email" id="testerEmail" required class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-teal-400 text-sm" placeholder="name@example.com">
            </div>
            <button type="submit" class="w-full bg-teal-500 hover:bg-teal-600 text-slate-900 font-bold p-3 rounded-lg transition text-sm cursor-pointer shadow-md shadow-teal-500/10">
                Request Testing Link
            </button>
        </form>

        <!-- Feature Previews (Interactive Log Counters) -->
        <div class="mt-8 pt-6 border-t border-slate-700/60 space-y-3">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Live Demo Logger</h3>
            <div class="flex items-center justify-between bg-slate-900/50 p-3 rounded-xl border border-slate-700/40">
                <span class="text-sm font-medium">Heart Rate Vitals Logged</span>
                <div class="flex items-center gap-3">
                    <span id="logCount" class="text-sm font-bold text-teal-400 bg-slate-900 px-2.5 py-1 rounded-md border border-slate-700">0</span>
                    <button id="addLogBtn" class="bg-teal-500/10 hover:bg-teal-500/20 text-teal-400 border border-teal-500/30 px-3 py-1 rounded-lg text-xs font-semibold transition cursor-pointer">+ Log Vital</button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Interactive Logic Engine -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('logSignupForm');
            const alertBox = document.getElementById('successAlert');
            const logCountSpan = document.getElementById('logCount');
            const addLogBtn = document.getElementById('addLogBtn');

            // Load saved interactive log count from device local memory
            let storedLogs = localStorage.getItem('petPulseDemoCount') || 0;
            logCountSpan.textContent = storedLogs;

            // Handle testing sign up form submission event
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                const testerData = {
                    name: document.getElementById('testerName').value,
                    email: document.getElementById('testerEmail').value,
                    timestamp: new Date().toISOString()
                };

                // Store submission details securely in client profile log
                localStorage.setItem('petPulseTesterProfile', JSON.stringify(testerData));
                console.log('New Private Tester Logged:', testerData);

                // Reset layout display state to reveal greeting confirmation
                form.reset();
                alertBox.classList.remove('hidden');
                
                setTimeout(() => {
                    alertBox.classList.add('hidden');
                }, 5000);
            });

            // Interactive demo counter button listener logic
            addLogBtn.addEventListener('click', () => {
                storedLogs++;
                localStorage.setItem('petPulseDemoCount', storedLogs);
                logCountSpan.textContent = storedLogs;
            });
        });
    </script>
</body>
</html>
